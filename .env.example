# Anthropic key for live AI reasoning (empty = mock)
ANTHROPIC_API_KEY=
# Local only: `ant auth login` profile to use instead of a key, such as default
ANTHROPIC_PROFILE=
# Claude model used for reasoning
LLM_MODEL=claude-sonnet-5-5
# Tavily key for live web search
TAVILY_API_KEY=
# Serper key for live web search
SERPER_API_KEY=
# Set to 1 to fetch pages with Playwright
PLAYWRIGHT=0
# Neo4j connection URI (empty = in-memory graph)
NEO4J_URI=
# Neo4j username
NEO4J_USER=
# Neo4j password
NEO4J_PASSWORD=
# Hunter key for contact enrichment
HUNTER_API_KEY=
# Apollo key for contact enrichment
APOLLO_API_KEY=
# Clearbit key for contact enrichment
CLEARBIT_API_KEY=
# Prospeo key for contact enrichment
PROSPEO_API_KEY=
# SendGrid key for sending email
SENDGRID_API_KEY=
# From address for SendGrid email
SENDGRID_FROM=
# Gmail API OAuth client ID
GMAIL_CLIENT_ID=
# Gmail API OAuth client secret
GMAIL_CLIENT_SECRET=
# Gmail API OAuth refresh token
GMAIL_REFRESH_TOKEN=
# Flexprice key for billing (empty = local credit ledger)
FLEXPRICE_API_KEY=
# Flexprice API base URL
FLEXPRICE_BASE_URL=https://us.api.flexprice.io/v1
# Organization ID used for billing
ORG_ID=demo-org
# Band bridge URL (empty = in-process agent room)
BAND_BRIDGE_URL=
# Secret that protects the cron routes
CRON_SECRET=
# One shared password for a hosted copy (empty = no password, local only)
SITE_PASSWORD=
